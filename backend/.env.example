# Puerto del servidor
PORT=portname

# Base de datos
# Lo llenaremos cuando configuremos Neon
DATABASE_URL=DB

# Clerk
CLERK_SECRET_KEY=clerkkey
CLERK_WEBHOOK_SECRET=clerkwebhook
# Firebase
FIREBASE_PROJECT_ID=firebase
FIREBASE_PRIVATE_KEY=firebase
FIREBASE_CLIENT_EMAIL=firebase

# Google Gemini
GEMINI_API_KEY=gemini

# Google Maps / Places API (New) — server-side proxy key
GOOGLE_PLACES_API_KEY=googleplaceskey

# Stripe
STRIPE_SECRET_KEY=stripekey

RAPIDAPI_KEY=rapidapikey

OPENAI_API_KEY=openaikey

# USDA FoodData Central (free key from https://fdc.nal.usda.gov/api-guide.html)
USDA_API_KEY=DEMO_KEY
# Cloudinary (format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME)
CLOUDINARY_URL=cloudinary