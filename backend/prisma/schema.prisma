generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIO ──────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  username      String    @unique
  name          String
  avatarUrl     String?
  bio           String?
  weight        Float?
  height        Float?
  bodyFat       Float?
  xp            Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastWorkout   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workouts         Workout[]
  goals            Goal[]
  workoutTemplates WorkoutTemplate[]
  customExercises  CustomExercise[]
  personalRecords  PersonalRecord[]

  @@map("users")
}

// ─── EJERCICIO GLOBAL ─────────────────────────────────
// Base de datos global de ejercicios
// Viene de ExerciseDB + los que nosotros agreguemos
model Exercise {
  id               String   @id @default(cuid())
  externalId       String?  @unique // ID de ExerciseDB
  name             String
  bodyPart         String
  target           String   // músculo primario
  equipment        String
  instructions     String[] // array de pasos
  secondaryMuscles String[] // músculos secundarios
  isCustom         Boolean  @default(false)
  createdByUserId  String?  // null = ejercicio global

  // Datos musculares para el modelo de estímulo
  muscleActivations MuscleActivation[]

  workoutSets     WorkoutSet[]
  templateSets    TemplateSet[]
  personalRecords PersonalRecord[]

  createdAt DateTime @default(now())

  @@map("exercises")
}

// ─── EJERCICIO PERSONALIZADO ──────────────────────────
// Ejercicios creados por usuarios específicos
model CustomExercise {
  id               String   @id @default(cuid())
  userId           String
  name             String
  bodyPart         String
  target           String
  equipment        String
  notes            String?
  secondaryMuscles String[]

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("custom_exercises")
}

// ─── ACTIVACIÓN MUSCULAR ──────────────────────────────
// Qué porcentaje trabaja cada músculo en cada ejercicio
// Ejemplo: Bench Press → Pecho 60%, Tríceps 25%, Hombro 15%
model MuscleActivation {
  id           String  @id @default(cuid())
  exerciseId   String
  muscleName   String  // "chest", "triceps", "anterior_deltoid"
  activationPct Float  // 0.0 a 1.0 (60% = 0.6)
  isPrimary    Boolean @default(false)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("muscle_activations")
}

// ─── PLANTILLA DE WORKOUT ─────────────────────────────
// Rutinas reutilizables
model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String   // "Pecho y Tríceps", "Push Day"
  description String?
  isPublic    Boolean  @default(false)
  timesUsed   Int      @default(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateSets TemplateSet[]
  workouts     Workout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workout_templates")
}

// ─── SET DE PLANTILLA ─────────────────────────────────
// Cada ejercicio dentro de una plantilla
model TemplateSet {
  id           String  @id @default(cuid())
  templateId   String
  exerciseId   String
  order        Int     // posición en la rutina (1, 2, 3...)
  targetSets   Int     // sets recomendados
  targetReps   Int?    // reps objetivo
  targetWeight Float?  // peso sugerido
  restSeconds  Int     @default(90)
  notes        String?

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id])

  @@map("template_sets")
}

// ─── WORKOUT ──────────────────────────────────────────
// Sesión de entrenamiento real
model Workout {
  id          String    @id @default(cuid())
  userId      String
  templateId  String?   // null si empezó vacío
  name        String
  notes       String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // minutos
  xpEarned    Int       @default(0)
  totalVolume Float     @default(0) // kg totales levantados
  isCompleted Boolean   @default(false)

  // Análisis muscular calculado al finalizar
  muscleStimulus Json?  // {"chest": 0.75, "triceps": 0.15}

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id])
  sets     WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workouts")
}

// ─── WORKOUT SET ──────────────────────────────────────
// Cada serie dentro de un workout
model WorkoutSet {
  id          String  @id @default(cuid())
  workoutId   String
  exerciseId  String
  order       Int     // orden del ejercicio en el workout
  setNumber   Int     // número de serie (1, 2, 3...)

  // Datos del set
  weight      Float?  // kg o lbs
  reps        Int?
  duration    Int?    // segundos (para cardio/planks)
  distance    Float?  // km (para cardio)
  rpe         Float?  // Rate of Perceived Exertion 1-10

  // Tipo de set
  setType     SetType @default(NORMAL)

  // Descanso
  restSeconds Int?    // descanso real tomado

  // Estado
  isCompleted Boolean @default(false)
  isPR        Boolean @default(false) // si fue récord personal

  notes       String?

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  createdAt DateTime @default(now())

  @@map("workout_sets")
}

// ─── TIPO DE SET ──────────────────────────────────────
enum SetType {
  NORMAL      // Set normal
  WARMUP      // Calentamiento (no cuenta para volumen)
  DROPSET     // Drop set
  SUPERSET    // Superserie
  FAILURE     // Hasta el fallo
  AMRAP       // As Many Reps As Possible
}

// ─── RÉCORD PERSONAL ──────────────────────────────────
// Guardamos el mejor set de cada ejercicio por usuario
model PersonalRecord {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  weight     Float?
  reps       Int?
  volume     Float?   // peso * reps
  oneRepMax  Float?   // 1RM estimado

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id])

  achievedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, exerciseId])
  @@map("personal_records")
}

// ─── GOAL ─────────────────────────────────────────────
model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetValue  Float?
  currentValue Float?
  unit         String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}