generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIO ──────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String    @unique
  username    String    @unique
  name        String
  avatarUrl   String?
  bio         String?
  weight      Float?
  height      Float?
  bodyFat     Float?
  calorieGoal    Int?
  proteinGoal    Float?
  carbsGoal      Float?
  fatGoal        Float?
  activityLevel  String?
  xp          Int       @default(0)
  level       Int       @default(1)
  streak      Int       @default(0)
  lastWorkout DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workouts         Workout[]
  goals            Goal[]
  foodLogs         FoodLog[]
  savedFoods       SavedFood[]
  aiChatMessages   AiChatMessage[]
  workoutTemplates WorkoutTemplate[]
  customExercises  CustomExercise[]
  personalRecords  PersonalRecord[]

  // Social (Sprint 4)
  followers                Follow[]                 @relation("UserFollowing")
  following                Follow[]                 @relation("UserFollowers")
  posts                    Post[]
  reactions                Reaction[]               @relation("UserReactions")
  comments                 Comment[]
  // Challenges (Sprint 4)
  createdChallenges        Challenge[]              @relation("ChallengeCreator")
  challengeParticipations  ChallengeParticipant[]
  // Gamification (Sprint 4)
  userBadges               UserBadge[]
  notifications            Notification[]           @relation("UserNotifications")

  dailySteps               DailySteps[]
  pushTokens               PushToken[]

  @@map("users")
}

// ─── EJERCICIO PERSONALIZADO ──────────────────────────
// ÚNICO modelo de ejercicio en nuestra DB.
// Solo ejercicios creados por usuarios.
// Los ejercicios de ExerciseDB se consultan
// en tiempo real y NUNCA se almacenan aquí.
model CustomExercise {
  id               String   @id @default(cuid())
  userId           String
  name             String
  bodyPart         String
  target           String   // músculo primario
  equipment        String
  notes            String?
  secondaryMuscles String[]
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSets     WorkoutSet[]
  templateSets    TemplateSet[]
  personalRecords PersonalRecord[]

  @@map("custom_exercises")
}

// ─── PLANTILLA DE WORKOUT ─────────────────────────────
model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateSets TemplateSet[]
  workouts     Workout[]

  @@map("workout_templates")
}

// ─── SET DE PLANTILLA ─────────────────────────────────
// Un ejercicio dentro de una plantilla.
// Puede ser de ExerciseDB (externalId) o custom.
model TemplateSet {
  id               String  @id @default(cuid())
  templateId       String
  order            Int

  // Referencia al ejercicio
  // Solo uno de estos dos debe estar presente
  externalId       String?          // ID de ExerciseDB
  exerciseName     String           // nombre para mostrar
  customExerciseId String?          // si es ejercicio custom

  targetSets       Int     @default(3)
  targetReps       Int?
  targetWeight     Float?
  restSeconds      Int     @default(90)
  notes            String?

  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customExercise  CustomExercise? @relation(fields: [customExerciseId], references: [id])

  @@map("template_sets")
}

// ─── WORKOUT ──────────────────────────────────────────
model Workout {
  id          String    @id @default(cuid())
  userId      String
  templateId  String?
  name        String
  notes       String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // minutos
  xpEarned    Int       @default(0)
  totalVolume Float     @default(0)
  isCompleted Boolean   @default(false)

  // Análisis muscular calculado al finalizar
  // Guardamos el resultado, no los datos fuente
  muscleStimulus Json?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id])
  sets     WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workouts")
}

// ─── WORKOUT SET ──────────────────────────────────────
// Cada serie dentro de un workout.
// Guardamos externalId + name como referencia.
// NUNCA guardamos gifUrl, instructions, etc.
model WorkoutSet {
  id    String @id @default(cuid())
  workoutId String
  order     Int    // orden del ejercicio en el workout
  setNumber Int    // número de serie (1, 2, 3...)

  // Referencia al ejercicio
  // Solo uno de estos dos debe estar presente
  externalId       String?  // ID de ExerciseDB (referencia)
  exerciseName     String   // nombre para mostrar en historial
  customExerciseId String?  // si es ejercicio custom

  // Datos del set
  weight      Float?
  reps        Int?
  duration    Int?   // segundos (cardio/planks)
  distance    Float? // km (cardio)
  rpe         Float? // Rate of Perceived Exertion 1-10

  setType     SetType @default(NORMAL)
  restSeconds Int?
  isCompleted Boolean @default(false)
  isPR        Boolean @default(false)
  notes       String?

  workout        Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])

  createdAt DateTime @default(now())

  @@map("workout_sets")
}

// ─── TIPO DE SET ──────────────────────────────────────
enum SetType {
  NORMAL
  WARMUP
  DROPSET
  SUPERSET
  FAILURE
  AMRAP
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FoodSource {
  MANUAL
  BARCODE
  AI_PHOTO
  SEARCH
  SAVED
}

enum PostType {
  TEXT
  IMAGE
  WORKOUT_SHARE
  PR_SHARE
  CHALLENGE_SHARE
  MILESTONE
}

enum ReactionType {
  FIRE
  MUSCLE
  CLAP
  TROPHY
  TARGET
}

enum ChallengeType {
  VOLUME
  FREQUENCY
  STREAK
  PR
  DISTANCE
  CUSTOM
}

enum ChallengeStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BadgeCategory {
  WORKOUT
  SOCIAL
  NUTRITION
  STREAK
  CHALLENGE
  MILESTONE
}

// ─── RÉCORD PERSONAL ──────────────────────────────────
// Guardamos externalId + name como referencia.
// NUNCA guardamos datos completos del ejercicio.
model PersonalRecord {
  id         String @id @default(cuid())
  userId     String

  // Referencia al ejercicio
  externalId       String?  // ID de ExerciseDB
  exerciseName     String   // nombre del ejercicio
  customExerciseId String?  // si es ejercicio custom

  weight     Float?
  reps       Int?
  volume     Float?  // peso * reps
  oneRepMax  Float?  // 1RM estimado

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])

  achievedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Un PR por ejercicio por usuario
  // La combinación externalId+userId o customExerciseId+userId es única
  @@unique([userId, externalId])
  @@unique([userId, customExerciseId])
  @@map("personal_records")
}

// ─── GOAL ─────────────────────────────────────────────
model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetValue  Float?
  currentValue Float?
  unit         String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

// ─── FOOD LOG (Registro diario) ───────────────────────
model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date

  totalCalories  Int     @default(0)
  totalProtein   Float   @default(0)
  totalCarbs     Float   @default(0)
  totalFat       Float   @default(0)
  totalFiber     Float   @default(0)

  calorieGoal    Int     @default(2000)
  proteinGoal    Float   @default(150)
  carbsGoal      Float   @default(250)
  fatGoal        Float   @default(65)
  waterMl        Int     @default(0)
  waterGoalMl    Int     @default(2500)

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries FoodEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("food_logs")
}

// ─── FOOD ENTRY (Cada alimento) ───────────────────────
model FoodEntry {
  id         String   @id @default(cuid())
  foodLogId  String
  mealType   MealType

  name       String
  brand      String?
  barcode    String?

  servingSize    Float
  servingUnit    String

  calories   Int
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float    @default(0)
  sugar      Float    @default(0)
  sodium     Float    @default(0)

  source       FoodSource @default(MANUAL)
  aiConfidence Float?
  imageUrl     String?

  foodLog  FoodLog  @relation(fields: [foodLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("food_entries")
}

// ─── SAVED FOODS (Favoritos) ──────────────────────────
model SavedFood {
  id       String  @id @default(cuid())
  userId   String

  name       String
  brand      String?
  barcode    String?

  servingSize    Float
  servingUnit    String
  calories       Int
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float   @default(0)

  isFavorite Boolean  @default(false)
  timesUsed  Int      @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_foods")
}

// ─── AI CHAT MESSAGES ─────────────────────────────────
model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  metadata  Json?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ai_chat_messages")
}

// ─── FOLLOWS ──────────────────────────────────────────
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String

  follower    User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

// ─── POSTS ────────────────────────────────────────────
model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String?
  imageUrls String[]
  postType  PostType @default(TEXT)

  workoutId   String?
  workoutData Json?

  isPublic  Boolean  @default(true)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  comments  Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

// ─── REACTIONS ────────────────────────────────────────
model Reaction {
  id       String       @id @default(cuid())
  postId   String
  userId   String
  type     ReactionType

  user    User @relation("UserReactions", fields: [userId], references: [id], onDelete: Cascade)
  post    Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("reactions")
}

// ─── COMMENTS ─────────────────────────────────────────
model Comment {
  id       String  @id @default(cuid())
  postId   String
  userId   String
  content  String
  parentId String?

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())

  @@map("comments")
}

// ─── CHALLENGES ───────────────────────────────────────
model Challenge {
  id          String          @id @default(cuid())
  creatorId   String
  title       String
  description String?
  type        ChallengeType
  status      ChallengeStatus @default(PENDING)

  goal            Float           // la meta numérica: ej 10000 kg
  unit            String          // "kg", "sesiones", "días", "km"
  startDate       DateTime
  endDate         DateTime
  isPublic        Boolean         @default(true)
  maxParticipants Int?            // null = sin límite
  xpReward        Int             @default(100)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  creator      User                   @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@map("challenges")
}

// ─── CHALLENGE PARTICIPANTS ───────────────────────────
model ChallengeParticipant {
  id           String  @id @default(cuid())
  challengeId  String
  userId       String
  currentValue Float   @default(0)
  isWinner     Boolean @default(false)
  rank         Int?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

// ─── BADGES ───────────────────────────────────────────
model Badge {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  icon        String
  category    BadgeCategory
  requirement Json
  xpReward    Int           @default(50)

  userBadges UserBadge[]

  @@map("badges")
}

// ─── USER BADGES ──────────────────────────────────────
model UserBadge {
  id      String @id @default(cuid())
  userId  String
  badgeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── NOTIFICATIONS ────────────────────────────────────
model Notification {
  id       String  @id @default(cuid())
  userId   String
  fromId   String?
  type     String
  title    String
  body     String?
  data     Json?
  isRead   Boolean @default(false)

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─── PUSH TOKENS ────────────────────────────────────────
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?  // "ios" | "android"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

// ─── DAILY STEPS ──────────────────────────────────────
model DailySteps {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date

  steps         Int      @default(0)
  goal          Int      @default(8500)
  calories      Float    @default(0)
  distanceKm    Float    @default(0)
  activeMinutes Int      @default(0)
  floors        Int      @default(0)

  hourlySteps   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_steps")
}