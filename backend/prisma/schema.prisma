generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIO ──────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String    @unique
  username    String    @unique
  name        String
  avatarUrl   String?
  bio         String?
  weight      Float?
  height      Float?
  bodyFat     Float?
  calorieGoal    Int?
  proteinGoal    Float?
  carbsGoal      Float?
  fatGoal        Float?
  activityLevel  String?
  xp          Int       @default(0)
  level       Int       @default(1)
  streak      Int       @default(0)
  lastWorkout DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workouts         Workout[]
  goals            Goal[]
  foodLogs         FoodLog[]
  savedFoods       SavedFood[]
  aiChatMessages   AiChatMessage[]
  workoutTemplates WorkoutTemplate[]
  customExercises  CustomExercise[]
  personalRecords  PersonalRecord[]

  @@map("users")
}

// ─── EJERCICIO PERSONALIZADO ──────────────────────────
// ÚNICO modelo de ejercicio en nuestra DB.
// Solo ejercicios creados por usuarios.
// Los ejercicios de ExerciseDB se consultan
// en tiempo real y NUNCA se almacenan aquí.
model CustomExercise {
  id               String   @id @default(cuid())
  userId           String
  name             String
  bodyPart         String
  target           String   // músculo primario
  equipment        String
  notes            String?
  secondaryMuscles String[]
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSets     WorkoutSet[]
  templateSets    TemplateSet[]
  personalRecords PersonalRecord[]

  @@map("custom_exercises")
}

// ─── PLANTILLA DE WORKOUT ─────────────────────────────
model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateSets TemplateSet[]
  workouts     Workout[]

  @@map("workout_templates")
}

// ─── SET DE PLANTILLA ─────────────────────────────────
// Un ejercicio dentro de una plantilla.
// Puede ser de ExerciseDB (externalId) o custom.
model TemplateSet {
  id               String  @id @default(cuid())
  templateId       String
  order            Int

  // Referencia al ejercicio
  // Solo uno de estos dos debe estar presente
  externalId       String?          // ID de ExerciseDB
  exerciseName     String           // nombre para mostrar
  customExerciseId String?          // si es ejercicio custom

  targetSets       Int     @default(3)
  targetReps       Int?
  targetWeight     Float?
  restSeconds      Int     @default(90)
  notes            String?

  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customExercise  CustomExercise? @relation(fields: [customExerciseId], references: [id])

  @@map("template_sets")
}

// ─── WORKOUT ──────────────────────────────────────────
model Workout {
  id          String    @id @default(cuid())
  userId      String
  templateId  String?
  name        String
  notes       String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // minutos
  xpEarned    Int       @default(0)
  totalVolume Float     @default(0)
  isCompleted Boolean   @default(false)

  // Análisis muscular calculado al finalizar
  // Guardamos el resultado, no los datos fuente
  muscleStimulus Json?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id])
  sets     WorkoutSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workouts")
}

// ─── WORKOUT SET ──────────────────────────────────────
// Cada serie dentro de un workout.
// Guardamos externalId + name como referencia.
// NUNCA guardamos gifUrl, instructions, etc.
model WorkoutSet {
  id    String @id @default(cuid())
  workoutId String
  order     Int    // orden del ejercicio en el workout
  setNumber Int    // número de serie (1, 2, 3...)

  // Referencia al ejercicio
  // Solo uno de estos dos debe estar presente
  externalId       String?  // ID de ExerciseDB (referencia)
  exerciseName     String   // nombre para mostrar en historial
  customExerciseId String?  // si es ejercicio custom

  // Datos del set
  weight      Float?
  reps        Int?
  duration    Int?   // segundos (cardio/planks)
  distance    Float? // km (cardio)
  rpe         Float? // Rate of Perceived Exertion 1-10

  setType     SetType @default(NORMAL)
  restSeconds Int?
  isCompleted Boolean @default(false)
  isPR        Boolean @default(false)
  notes       String?

  workout        Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])

  createdAt DateTime @default(now())

  @@map("workout_sets")
}

// ─── TIPO DE SET ──────────────────────────────────────
enum SetType {
  NORMAL
  WARMUP
  DROPSET
  SUPERSET
  FAILURE
  AMRAP
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FoodSource {
  MANUAL
  BARCODE
  AI_PHOTO
  SEARCH
  SAVED
}

// ─── RÉCORD PERSONAL ──────────────────────────────────
// Guardamos externalId + name como referencia.
// NUNCA guardamos datos completos del ejercicio.
model PersonalRecord {
  id         String @id @default(cuid())
  userId     String

  // Referencia al ejercicio
  externalId       String?  // ID de ExerciseDB
  exerciseName     String   // nombre del ejercicio
  customExerciseId String?  // si es ejercicio custom

  weight     Float?
  reps       Int?
  volume     Float?  // peso * reps
  oneRepMax  Float?  // 1RM estimado

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])

  achievedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Un PR por ejercicio por usuario
  // La combinación externalId+userId o customExerciseId+userId es única
  @@unique([userId, externalId])
  @@unique([userId, customExerciseId])
  @@map("personal_records")
}

// ─── GOAL ─────────────────────────────────────────────
model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetValue  Float?
  currentValue Float?
  unit         String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

// ─── FOOD LOG (Registro diario) ───────────────────────
model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date

  totalCalories  Int     @default(0)
  totalProtein   Float   @default(0)
  totalCarbs     Float   @default(0)
  totalFat       Float   @default(0)
  totalFiber     Float   @default(0)

  calorieGoal    Int     @default(2000)
  proteinGoal    Float   @default(150)
  carbsGoal      Float   @default(250)
  fatGoal        Float   @default(65)
  waterMl        Int     @default(0)
  waterGoalMl    Int     @default(2500)

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries FoodEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("food_logs")
}

// ─── FOOD ENTRY (Cada alimento) ───────────────────────
model FoodEntry {
  id         String   @id @default(cuid())
  foodLogId  String
  mealType   MealType

  name       String
  brand      String?
  barcode    String?

  servingSize    Float
  servingUnit    String

  calories   Int
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float    @default(0)
  sugar      Float    @default(0)
  sodium     Float    @default(0)

  source       FoodSource @default(MANUAL)
  aiConfidence Float?
  imageUrl     String?

  foodLog  FoodLog  @relation(fields: [foodLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("food_entries")
}

// ─── SAVED FOODS (Favoritos) ──────────────────────────
model SavedFood {
  id       String  @id @default(cuid())
  userId   String

  name       String
  brand      String?
  barcode    String?

  servingSize    Float
  servingUnit    String
  calories       Int
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float   @default(0)

  isFavorite Boolean  @default(false)
  timesUsed  Int      @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_foods")
}

// ─── AI CHAT MESSAGES ─────────────────────────────────
model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  metadata  Json?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ai_chat_messages")
}