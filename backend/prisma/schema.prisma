generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── USUARIO ──────────────────────────────────────────
model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String    @unique
  username    String    @unique
  name        String
  avatarUrl       String?
  avatarPublicId  String?
  bio         String?
  weight      Float?
  height      Float?
  bodyFat     Float?
  calorieGoal    Int?
  proteinGoal    Float?
  carbsGoal      Float?
  fatGoal        Float?
  activityLevel  String?

  // Fasting
  fastingEnabled    Boolean  @default(false)
  fastingProtocol   String?  // "16:8", "18:6", "20:4", "custom"
  fastingStartHour  Int?     // Hora inicio ayuno (0-23)
  fastingHours      Int?     // Horas de ayuno

  // Micro-nutrient goals
  fiberGoal     Float?   // default 25g
  sugarGoal     Float?   // default 30g (OMS)
  sodiumGoal    Float?   // default 2300mg
  xp              Int       @default(0)
  level           Int       @default(1)
  streak          Int       @default(0)
  bestStreak      Int       @default(0)
  lastWorkout     DateTime?
  featuredBadgeId String?
  initialWeight   Float?
  initialBodyFat  Float?

  // Onboarding
  dateOfBirth         DateTime?
  gender              String?
  experienceLevel     String?
  weeklyTrainingDays  Int?
  onboardingCompleted Boolean   @default(false)
  onboardingStep      Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  featuredBadge    Badge?    @relation("FeaturedBadge", fields: [featuredBadgeId], references: [id])
  workouts         Workout[]
  goals            Goal[]
  foodLogs         FoodLog[]
  savedFoods       SavedFood[]
  aiChatMessages   AiChatMessage[]
  workoutTemplates WorkoutTemplate[]
  customExercises  CustomExercise[]
  personalRecords  PersonalRecord[]

  // Social (Sprint 4)
  followers                Follow[]                 @relation("UserFollowing")
  following                Follow[]                 @relation("UserFollowers")
  posts                    Post[]
  reactions                Reaction[]               @relation("UserReactions")
  comments                 Comment[]
  // Challenges (Sprint 4)
  createdChallenges        Challenge[]              @relation("ChallengeCreator")
  challengeParticipations  ChallengeParticipant[]
  // Gamification (Sprint 4)
  userBadges               UserBadge[]
  notifications            Notification[]           @relation("UserNotifications")

  guildWarContributions    GuildWarContribution[]

  dailySteps               DailySteps[]
  pushTokens               PushToken[]
  media                    Media[]

  // Onboarding relations
  goalPreferences          UserGoalPreference[]
  hobbies                  UserHobby[]
  places                   UserPlace[]
  createdPlaces            Place[]                  @relation("PlaceCreator")

  // Enhanced Profile
  weightLogs               WeightLog[]
  showcase                 ProfileShowcase?

  // Wellness (Sprint 7)
  moodLogs                 MoodLog[]
  sleepLogs                SleepLog[]
  journalEntries           JournalEntry[]
  breathingSessions        BreathingSession[]
  sorenessLogs             SorenessLog[]
  readinessScores          ReadinessScore[]

  // Guilds (Sprint 8 — Social)
  createdGuilds            Guild[]              @relation("GuildCreator")
  guildMemberships         GuildMember[]

  @@map("users")
}

// ─── CATÁLOGO DE EJERCICIOS ──────────────────────────
// 800+ ejercicios almacenados localmente (seed desde free-exercise-db).
// Reemplaza la dependencia de ExerciseDB RapidAPI.
model Exercise {
  id               String   @id @default(cuid())
  externalId       String?  @unique
  name             String
  bodyPart         String
  target           String
  equipment        String
  instructions     String[]
  secondaryMuscles String[]
  gifUrl           String?
  difficulty       String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([bodyPart])
  @@index([equipment])
  @@index([bodyPart, equipment])
  @@index([name])
  @@map("exercises")
}

// ─── EJERCICIO PERSONALIZADO ──────────────────────────
// Ejercicios creados por los propios usuarios.
model CustomExercise {
  id               String   @id @default(cuid())
  userId           String
  name             String
  bodyPart         String
  target           String   // músculo primario
  equipment        String
  notes            String?
  secondaryMuscles String[]
  isPublic         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutSets     WorkoutSet[]
  templateSets    TemplateSet[]
  personalRecords PersonalRecord[]

  @@map("custom_exercises")
}

// ─── PLANTILLA DE WORKOUT ─────────────────────────────
model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean  @default(false)
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateSets TemplateSet[]
  workouts     Workout[]

  @@map("workout_templates")
}

// ─── SET DE PLANTILLA ─────────────────────────────────
// Un ejercicio dentro de una plantilla.
// Puede ser de ExerciseDB (externalId) o custom.
model TemplateSet {
  id               String  @id @default(cuid())
  templateId       String
  order            Int

  // Referencia al ejercicio
  // Solo uno de estos dos debe estar presente
  externalId       String?          // ID de ExerciseDB
  exerciseName     String           // nombre para mostrar
  customExerciseId String?          // si es ejercicio custom

  targetSets       Int     @default(3)
  targetReps       Int?
  targetWeight     Float?
  restSeconds      Int     @default(90)
  notes            String?

  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  customExercise  CustomExercise? @relation(fields: [customExerciseId], references: [id])

  @@map("template_sets")
}

// ─── WORKOUT ──────────────────────────────────────────
model Workout {
  id          String    @id @default(cuid())
  userId      String
  templateId  String?
  name        String
  notes       String?
  startTime   DateTime
  endTime     DateTime?
  duration    Int?      // minutos
  xpEarned    Int       @default(0)
  totalVolume Float     @default(0)
  isCompleted Boolean   @default(false)

  // Análisis muscular calculado al finalizar
  // Guardamos el resultado, no los datos fuente
  muscleStimulus Json?

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template      WorkoutTemplate? @relation(fields: [templateId], references: [id])
  sets          WorkoutSet[]
  moodLogs      MoodLog[]
  journalEntries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workouts")
}

// ─── WORKOUT SET ──────────────────────────────────────
// Cada serie dentro de un workout.
// Guardamos externalId + name como referencia.
// NUNCA guardamos gifUrl, instructions, etc.
model WorkoutSet {
  id    String @id @default(cuid())
  workoutId String
  order     Int    // orden del ejercicio en el workout
  setNumber Int    // número de serie (1, 2, 3...)

  // Referencia al ejercicio
  // Solo uno de estos dos debe estar presente
  externalId       String?  // ID de ExerciseDB (referencia)
  exerciseName     String   // nombre para mostrar en historial
  customExerciseId String?  // si es ejercicio custom

  // Datos del set
  weight      Float?
  reps        Int?
  duration    Int?   // segundos (cardio/planks)
  distance    Float? // km (cardio)
  rpe         Float? // Rate of Perceived Exertion 1-10

  setType     SetType @default(NORMAL)
  restSeconds Int?
  isCompleted Boolean @default(false)
  isPR        Boolean @default(false)
  notes       String?

  workout        Workout         @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])

  createdAt DateTime @default(now())

  @@map("workout_sets")
}

// ─── TIPO DE SET ──────────────────────────────────────
enum SetType {
  NORMAL
  WARMUP
  DROPSET
  SUPERSET
  FAILURE
  AMRAP
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum FoodSource {
  MANUAL
  BARCODE
  AI_PHOTO
  AI_TEXT
  SEARCH
  SAVED
}

enum PostType {
  TEXT
  IMAGE
  VIDEO
  WORKOUT_SHARE
  PR_SHARE
  CHALLENGE_SHARE
  MILESTONE
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ReactionType {
  FIRE
  MUSCLE
  CLAP
  TROPHY
  TARGET
}

enum ChallengeType {
  VOLUME
  FREQUENCY
  STREAK
  PR
  DISTANCE
  CUSTOM
  // Wellness
  SLEEP_STREAK
  MOOD_STREAK
  BREATHING_MINUTES
  READINESS_AVG
}

enum ChallengeMode {
  MILESTONE   // Carrera: el primero que llega al goal gana
  TIMED       // Competencia: al terminar el tiempo, el mejor puntaje gana
}

enum ChallengeStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BadgeCategory {
  WORKOUT
  VOLUME
  SOCIAL
  NUTRITION
  STREAK
  CHALLENGE
  MILESTONE
  STEPS
  PR
  SECRET
  WELLNESS
}

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

// ─── RÉCORD PERSONAL ──────────────────────────────────
// Guardamos externalId + name como referencia.
// NUNCA guardamos datos completos del ejercicio.
model PersonalRecord {
  id         String @id @default(cuid())
  userId     String

  // Referencia al ejercicio
  externalId       String?  // ID de ExerciseDB
  exerciseName     String   // nombre del ejercicio
  customExerciseId String?  // si es ejercicio custom

  weight     Float?
  reps       Int?
  volume     Float?  // peso * reps
  oneRepMax  Float?  // 1RM estimado

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customExercise CustomExercise? @relation(fields: [customExerciseId], references: [id])

  achievedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Un PR por ejercicio por usuario
  // La combinación externalId+userId o customExerciseId+userId es única
  @@unique([userId, externalId])
  @@unique([userId, customExerciseId])
  @@map("personal_records")
}

// ─── GOAL ─────────────────────────────────────────────
model Goal {
  id           String   @id @default(cuid())
  userId       String
  title        String
  description  String?
  targetValue  Float?
  currentValue Float?
  unit         String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

// ─── FOOD LOG (Registro diario) ───────────────────────
model FoodLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date

  totalCalories  Int     @default(0)
  totalProtein   Float   @default(0)
  totalCarbs     Float   @default(0)
  totalFat       Float   @default(0)
  totalFiber     Float   @default(0)

  calorieGoal    Int     @default(2000)
  proteinGoal    Float   @default(150)
  carbsGoal      Float   @default(250)
  fatGoal        Float   @default(65)
  waterMl        Int     @default(0)
  waterGoalMl    Int     @default(2500)

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries FoodEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("food_logs")
}

// ─── FOOD ENTRY (Cada alimento) ───────────────────────
model FoodEntry {
  id         String   @id @default(cuid())
  foodLogId  String
  mealType   MealType

  name       String
  brand      String?
  barcode    String?

  servingSize    Float
  servingUnit    String

  calories   Int
  protein    Float
  carbs      Float
  fat        Float
  fiber      Float    @default(0)
  sugar      Float    @default(0)
  sodium     Float    @default(0)

  source       FoodSource @default(MANUAL)
  aiConfidence Float?
  imageUrl     String?

  foodLog  FoodLog  @relation(fields: [foodLogId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("food_entries")
}

// ─── SAVED FOODS (Favoritos) ──────────────────────────
model SavedFood {
  id       String  @id @default(cuid())
  userId   String

  name       String
  brand      String?
  barcode    String?

  servingSize    Float
  servingUnit    String
  calories       Int
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float   @default(0)

  isFavorite Boolean  @default(false)
  timesUsed  Int      @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@map("saved_foods")
}

// ─── FOOD CACHE (Global cache de APIs externas) ──────
model FoodCache {
  id        String   @id @default(cuid())

  barcode   String?  @unique
  name      String
  brand     String?
  source    String   // "OPEN_FOOD_FACTS" | "USDA"
  sourceId  String?  // OFF code o USDA fdcId

  servingSize    Float
  servingUnit    String
  calories       Int
  protein        Float
  carbs          Float
  fat            Float
  fiber          Float    @default(0)
  sugar          Float    @default(0)
  sodium         Float    @default(0)

  imageUrl  String?
  rawData   Json?

  searchHits Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([barcode])
  @@map("food_cache")
}

// ─── AI CHAT MESSAGES ─────────────────────────────────
model AiChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  metadata  Json?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ai_chat_messages")
}

// ─── FOLLOWS ──────────────────────────────────────────
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String

  follower    User @relation("UserFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@map("follows")
}

// ─── POSTS ────────────────────────────────────────────
model Post {
  id        String   @id @default(cuid())
  userId    String
  content   String?
  imageUrls String[]
  postType  PostType @default(TEXT)

  workoutId   String?
  workoutData Json?

  isPublic  Boolean  @default(true)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions Reaction[]
  comments  Comment[]
  media     Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

// ─── REACTIONS ────────────────────────────────────────
model Reaction {
  id       String       @id @default(cuid())
  postId   String
  userId   String
  type     ReactionType

  user    User @relation("UserReactions", fields: [userId], references: [id], onDelete: Cascade)
  post    Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("reactions")
}

// ─── COMMENTS ─────────────────────────────────────────
model Comment {
  id       String  @id @default(cuid())
  postId   String
  userId   String
  content  String
  parentId String?

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())

  @@map("comments")
}

// ─── CHALLENGES ───────────────────────────────────────
model Challenge {
  id          String          @id @default(cuid())
  creatorId   String
  title       String
  description String?
  type        ChallengeType
  mode        ChallengeMode   @default(MILESTONE)
  status      ChallengeStatus @default(PENDING)

  goal            Float           // la meta numérica: ej 10000 kg
  unit            String          // "kg", "sesiones", "días", "km"
  startDate       DateTime
  endDate         DateTime
  isPublic        Boolean         @default(true)
  maxParticipants Int?            // null = sin límite
  xpReward        Int             @default(100)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  creator      User                   @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@map("challenges")
}

// ─── CHALLENGE PARTICIPANTS ───────────────────────────
model ChallengeParticipant {
  id           String  @id @default(cuid())
  challengeId  String
  userId       String
  currentValue Float   @default(0)
  isWinner     Boolean @default(false)
  rank         Int?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, userId])
  @@map("challenge_participants")
}

// ─── BADGES ───────────────────────────────────────────
model Badge {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  icon        String
  category    BadgeCategory
  rarity      BadgeRarity   @default(COMMON)
  requirement Json
  xpReward    Int           @default(50)
  isSecret    Boolean       @default(false)
  sortOrder   Int           @default(0)

  userBadges    UserBadge[]
  featuredUsers User[]      @relation("FeaturedBadge")

  createdAt DateTime @default(now())

  @@map("badges")
}

// ─── USER BADGES ──────────────────────────────────────
model UserBadge {
  id      String  @id @default(cuid())
  userId  String
  badgeId String
  isSeen  Boolean @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ─── NOTIFICATIONS ────────────────────────────────────
model Notification {
  id       String  @id @default(cuid())
  userId   String
  fromId   String?
  type     String
  title    String
  body     String?
  data     Json?
  isRead   Boolean @default(false)

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─── PUSH TOKENS ────────────────────────────────────────
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?  // "ios" | "android"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_tokens")
}

// ─── MEDIA ───────────────────────────────────────────
model Media {
  id          String    @id @default(cuid())
  userId      String
  publicId    String    @unique
  url         String
  type        MediaType
  width       Int?
  height      Int?
  bytes       Int?
  duration    Float?
  thumbnailUrl String?

  postId      String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([postId])
  @@map("media")
}

// ─── DAILY STEPS ──────────────────────────────────────
model DailySteps {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date

  steps         Int      @default(0)
  goal          Int      @default(8500)
  calories      Float    @default(0)
  distanceKm    Float    @default(0)
  activeMinutes Int      @default(0)
  floors        Int      @default(0)

  hourlySteps   Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@map("daily_steps")
}

// ─── ONBOARDING: GOAL PREFERENCES ───────────────────
model UserGoalPreference {
  id         String   @id @default(cuid())
  userId     String
  goalSlug   String
  customText String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, goalSlug])
  @@map("user_goal_preferences")
}

// ─── ONBOARDING: HOBBIES ────────────────────────────
model UserHobby {
  id        String @id @default(cuid())
  userId    String
  hobbySlug String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, hobbySlug])
  @@map("user_hobbies")
}

// ─── PLACES (Gyms, Universities, etc.) ──────────────
enum PlaceType {
  GYM
  UNIVERSITY
  CLUB
  PARK
  OTHER
}

model Place {
  id          String    @id @default(cuid())
  name        String
  type        PlaceType @default(GYM)
  address     String?
  latitude    Float
  longitude   Float
  createdById String

  createdBy User      @relation("PlaceCreator", fields: [createdById], references: [id])
  members   UserPlace[]
  guild     Guild?       // FORGE guild auto-linked to this place

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude, longitude])
  @@map("places")
}

// ─── USER ↔ PLACE ───────────────────────────────────
model UserPlace {
  id        String  @id @default(cuid())
  userId    String
  placeId   String
  isPrimary Boolean @default(true)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, placeId])
  @@map("user_places")
}

// ─── WEIGHT LOG (historial de peso) ─────────────────
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  bodyFat   Float?
  note      String?
  loggedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("weight_logs")
}

// ─── PROFILE SHOWCASE (badges destacados) ───────────
model ProfileShowcase {
  id        String   @id @default(cuid())
  userId    String   @unique
  badgeIds  String[] // IDs de badges a mostrar (max 4)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("profile_showcases")
}

// ═══════════════════════════════════════════════════════
// ─── WELLNESS SYSTEM (Sprint 7) ───────────────────────
// ═══════════════════════════════════════════════════════

// ─── MOOD LOG ────────────────────────────────────────
model MoodLog {
  id        String      @id @default(cuid())
  userId    String
  mood      Int         // 1-5 (terrible → excelente)
  energy    Int         // 1-5 (agotado → explosivo)
  stress    Int         // 1-5 (relajado → muy estresado)
  note      String?
  context   MoodContext @default(STANDALONE)
  workoutId String?

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout?    @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  loggedAt  DateTime    @default(now())

  @@index([userId, loggedAt])
  @@map("mood_logs")
}

enum MoodContext {
  STANDALONE
  PRE_WORKOUT
  POST_WORKOUT
}

// ─── SLEEP LOG ───────────────────────────────────────
model SleepLog {
  id              String     @id @default(cuid())
  userId          String
  date            DateTime   @db.Date
  bedTime         DateTime
  wakeTime        DateTime
  durationMinutes Int
  quality         Int        @default(3) // 1-5
  awakenings      Int        @default(0)
  sleepScore      Int?       // 0-100, calculado
  notes           String?
  source          DataSource @default(MANUAL)

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("sleep_logs")
}

enum DataSource {
  MANUAL
  HEALTH_KIT
  HEALTH_CONNECT
  OURA
  WHOOP
  GARMIN
}

// ─── READINESS SCORE (calculado diario) ──────────────
model ReadinessScore {
  id                String        @id @default(cuid())
  userId            String
  date              DateTime      @db.Date
  score             Int           // 0-100
  sleepComponent    Int           // 0-35
  moodComponent     Int           // 0-20
  stressComponent   Int           // 0-15
  loadComponent     Int           // 0-20
  sorenessComponent Int           // 0-10
  zone              ReadinessZone
  recommendation    String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("readiness_scores")
}

enum ReadinessZone {
  RED
  YELLOW
  GREEN
}

// ─── JOURNAL ENTRY ───────────────────────────────────
model JournalEntry {
  id        String      @id @default(cuid())
  userId    String
  content   String
  type      JournalType @default(FREE)
  mood      Int?
  tags      String[]
  workoutId String?

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout   Workout?    @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@map("journal_entries")
}

enum JournalType {
  FREE
  GRATITUDE
  REFLECTION
  PRE_WORKOUT
}

// ─── BREATHING SESSION ───────────────────────────────
model BreathingSession {
  id          String             @id @default(cuid())
  userId      String
  technique   BreathingTechnique
  durationSec Int
  targetSec   Int
  completed   Boolean            @default(true)
  moodBefore  Int?
  moodAfter   Int?

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("breathing_sessions")
}

enum BreathingTechnique {
  BOX_4_4_4_4
  RELAXING_4_7_8
  WIM_HOF
  COHERENT_5_5
  ENERGIZING_4_2
}

// ─── SORENESS LOG (DOMS tracking) ────────────────────
model SorenessLog {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @db.Date
  muscleData      Json     // { "chest": 3, "quads": 4, ... }
  overallSoreness Int      @default(0) // 0-5
  notes           String?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("soreness_logs")
}

// ═══════════════════════════════════════════════════════
// ─── GUILDS SYSTEM (Sprint 8 — Social) ────────────────
// ═══════════════════════════════════════════════════════

enum GuildType {
  FORGE       // Gym-based (auto-created per Place)
  WAR_PARTY   // Private (invite-only, friends)
  OPEN        // Public (anyone can request to join)
}

enum GuildRole {
  FOUNDER
  WARDEN      // Admin (max 3)
  CAPTAIN     // Moderator (max 5)
  MEMBER
  RECRUIT     // 7-day probation
}

model Guild {
  id          String    @id @default(cuid())
  name        String
  tag         String    @unique   // 2-5 char tag e.g. "IRWV"
  type        GuildType
  motto       String?             // Editable motto, max 60 chars
  description String?
  iconUrl     String?             // Guild emblem image
  colorPrimary   String  @default("#6C63FF")
  colorSecondary String  @default("#1A1A2E")

  // Capacity
  maxMembers  Int       @default(30)
  level       Int       @default(1)
  xp          Int       @default(0)

  // Linked Place (only for FORGE guilds)
  placeId     String?   @unique   // 1:1 with Place for FORGE type
  place       Place?    @relation(fields: [placeId], references: [id])

  // Creator
  creatorId   String?
  creator     User?     @relation("GuildCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  // Stats (cached, updated periodically)
  avgStreak       Float   @default(0)
  activeMembersToday Int  @default(0)
  totalVolume     Float   @default(0)
  totalSteps      Int     @default(0)
  nationalRank    Int?

  members     GuildMember[]

  // Wars
  warsAsChallenger GuildWar[] @relation("WarChallenger")
  warsAsDefender   GuildWar[] @relation("WarDefender")

  guildWarContributions GuildWarContribution[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([nationalRank])
  @@map("guilds")
}

model GuildMember {
  id        String    @id @default(cuid())
  guildId   String
  userId    String
  role      GuildRole @default(RECRUIT)
  isPrimary Boolean   @default(false)  // Is this the user's main guild?

  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime  @default(now())
  promotedAt DateTime?

  @@unique([guildId, userId])
  @@index([userId])
  @@map("guild_members")
}

// ═══════════════════════════════════════════════════════
// ─── GUILD WARS (Sprint 8 — Phase 5) ──────────────────
// ═══════════════════════════════════════════════════════

enum WarType {
  TOTAL_WAR         // Combined points (workouts + steps + nutrition)
  IRON_CLASH        // Total volume lifted (kg)
  MARATHON          // Collective steps
  CONSISTENCY       // % members maintaining streak during war
}

enum WarStatus {
  PENDING           // Challenge sent, awaiting acceptance
  ACTIVE            // War in progress
  COMPLETED         // War finished, winner determined
  DECLINED          // Challenge was declined
  CANCELLED         // Cancelled before acceptance
}

model GuildWar {
  id              String    @id @default(cuid())
  type            WarType
  status          WarStatus @default(PENDING)

  // Participants
  challengerGuildId String
  defenderGuildId   String
  challengerGuild   Guild   @relation("WarChallenger", fields: [challengerGuildId], references: [id], onDelete: Cascade)
  defenderGuild     Guild   @relation("WarDefender", fields: [defenderGuildId], references: [id], onDelete: Cascade)

  // Scoring (normalized per active member)
  challengerScore Float     @default(0)
  defenderScore   Float     @default(0)
  challengerActive Int      @default(0)  // Active members during war
  defenderActive   Int      @default(0)

  // Winner
  winnerGuildId   String?
  mvpUserId       String?   // Most War Points in winning guild

  // Timing
  durationDays    Int       @default(5)
  startDate       DateTime?
  endDate         DateTime?
  acceptDeadline  DateTime  // 24h to accept

  // Rewards
  xpReward        Int       @default(250)

  contributions   GuildWarContribution[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([challengerGuildId])
  @@index([defenderGuildId])
  @@index([status])
  @@map("guild_wars")
}

model GuildWarContribution {
  id        String   @id @default(cuid())
  warId     String
  userId    String
  guildId   String   // Which guild this user contributed for
  date      DateTime @db.Date

  // War Points breakdown
  workoutWP   Int    @default(0)  // +10 per workout
  nutritionWP Int    @default(0)  // +5 per full nutrition log
  stepsWP     Int    @default(0)  // +5 for >=8000 steps
  streakWP    Int    @default(0)  // +3 streak bonus
  prWP        Int    @default(0)  // +15 for PR during war
  totalWP     Int    @default(0)

  war       GuildWar @relation(fields: [warId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([warId, userId, date])
  @@index([warId, guildId])
  @@map("guild_war_contributions")
}