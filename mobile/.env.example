EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=clerkkey
EXPO_PUBLIC_RAPIDAPI_KEY=rapidapikey
# Cloudinary (public - safe for mobile, upload uses unsigned preset)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=cloudname
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=preset

# Google Maps (build-time only — used by app.config.ts for native Maps SDK)
GOOGLE_MAPS_API_KEY_ANDROID=mapsandroid
GOOGLE_MAPS_API_KEY_IOS=mapsios